# Plantilla de variables. Copiar a ".env" y rellenar con los valores propios.
# El archivo .env NUNCA se sube a Git.
# No escribas comentarios en la misma línea que un valor.

# ── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True

# ── W14–W15: Stripe (claves de prueba) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_TU_CLAVE
STRIPE_PUBLISHABLE_KEY=pk_test_TU_CLAVE
STRIPE_WEBHOOK_SECRET=whsec_TU_SECRETO

# ── W16: Celery / Redis ───────────────────────────────────────────────────
# Vacía en la PC (sin Docker): las tareas se ejecutan en modo EAGER.
# Con Docker local: redis://localhost:6379/0
# En Render: Internal Key Value URL (redis://red-...:6379)
REDIS_URL=
# En Render debe ser 1 (worker dentro del contenedor web)
CELERY_EMBEDDED_WORKER=0

# ── W17: Correo (django-anymail + SendGrid) ───────────────────────────────
# En la PC el correo se imprime en la terminal. En Render se usa SendGrid
# automáticamente si existe SENDGRID_API_KEY (ahí NO definir EMAIL_BACKEND).
SENDGRID_API_KEY=
# Debe ser el "From" verificado en SendGrid (Sender Authentication)
DEFAULT_FROM_EMAIL=ERP Django <tu-correo-verificado@gmail.com>
# Recibe las alertas de stock y el reporte diario
ADMIN_EMAIL=tu-correo-admin@gmail.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Solo si quieres otra URL en los enlaces (Render usa RENDER_EXTERNAL_URL)
# SITE_URL=http://127.0.0.1:8000

# ── W18: Celery Beat ──────────────────────────────────────────────────────
# 1 = en Render el worker también programa las tareas
CELERY_EMBEDDED_BEAT=1
# Hora del reporte diario, formato 24 h, hora de México
REPORTE_DIARIO_HORA=23:00

# ── Opcional, solo Render: crear el superusuario al arrancar ──────────────
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
